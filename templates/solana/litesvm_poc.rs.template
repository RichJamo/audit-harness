//        litesvm = "0.15"                    # verified latest on crates.io (2026-07-23)
//        solana-sdk = "*"                    # pin to match your installed Agave; check crates.io
//        solana-program = "*"                #   (Agave 3.x/4.x — the sdk crate line diverges; verify)
//        spl-token = "*"                     # if the target uses SPL Token / Token-2022
//        spl-associated-token-account = "*"
//   3) Fill every TODO. Run: `cargo test --release -- --nocapture`  (see logs via --nocapture).
//
