use litesvm::LiteSVM;
use solana_sdk::{
    account::ReadableAccount,
    instruction::{AccountMeta, Instruction},
    message::Message,
    pubkey::Pubkey,
    signature::{Keypair, Signer},
    transaction::Transaction,
};

// TODO: the program id the `.so` was BUILT for (Anchor `declare_id!`). PDAs derive from this —
// a wrong id makes every seeded-address check silently mismatch. Rebuild if you change it.
const PROGRAM_ID: Pubkey = solana_sdk::pubkey!("Fill1nProgramIdMatching11111111111111111111");

// System program id as a version-proof literal (all-1s). The `solana_sdk::system_program` module
// moved out of the crate root in solana-sdk v4 — this literal avoids the churn. VERIFIED to compile
// against litesvm 0.15 + solana-sdk 4.0.1 (2026-07-23).
const SYSTEM_PROGRAM_ID: Pubkey = solana_sdk::pubkey!("11111111111111111111111111111111");

// Anchor global instruction discriminator = first 8 bytes of sha256("global:<ix_name>").
// (Non-Anchor programs: use the target's own instruction tag/enum layout instead.)
fn anchor_discriminator(ix_name: &str) -> [u8; 8] {
    use solana_sdk::hash::hash;
    let h = hash(format!("global:{ix_name}").as_bytes());
    let mut d = [0u8; 8];
    d.copy_from_slice(&h.to_bytes()[..8]);
    d
}

/// Deploy the program + honest state the way an integration environment would. Keep this the
/// single source of "how the system stands up" so "reachable here" == "reachable in prod".
fn setup() -> (LiteSVM, Keypair) {
    let mut svm = LiteSVM::new();

    // Load the compiled program at its declared id.
    svm.add_program_from_file(PROGRAM_ID, "target/deploy/PROGRAM.so")
        .expect("load .so — build it first (anchor build / cargo build-sbf)");

    // Fund a payer/attacker.
    let attacker = Keypair::new();
    svm.airdrop(&attacker.pubkey(), 10_000_000_000).unwrap(); // 10 SOL

    // TODO: honest setup — initialize config/vault PDA(s), create mint(s), fund an honest user's
    // token account with the funds the attacker will try to steal, etc. Do it through the
    // program's OWN instructions where possible (so the starting state is a real reachable state).

    (svm, attacker)
}

/// Derive a PDA the way the program does. Confirm the seeds against the on-chain
/// `seeds = [...]` / `Pubkey::find_program_address` in the source — a seed mismatch here is the
/// #1 reason a Solana PoC "mysteriously" fails to reproduce.
fn pda(seeds: &[&[u8]]) -> (Pubkey, u8) {
    Pubkey::find_program_address(seeds, &PROGRAM_ID)
}

