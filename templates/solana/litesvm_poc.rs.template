// ---- small readers (fill offsets from the target's #[account] struct layout) ----
// Anchor accounts begin with an 8-byte discriminator, then borsh fields. `spl_token::state::
// Account::unpack` reads an SPL token account's `amount`.
#[allow(dead_code)]
fn read_u64_field(svm: &LiteSVM, key: &Pubkey, offset: usize) -> u64 {
    let acct = svm.get_account(key).expect("account missing");
    let bytes = &acct.data()[offset..offset + 8];
    u64::from_le_bytes(bytes.try_into().unwrap())
}
