    }

    // Once this passes, the paired invariant/PoC's green/red result is trustworthy: you have shown the
    // code the assertion guards is actually exercised. Keep this test in the suite (do NOT delete it,
    // unlike the throwaway canary) — it is the standing proof-of-reachability for the seam.
}
