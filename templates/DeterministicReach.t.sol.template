pragma solidity ^0.8.20;

// ===========================================================================================
// DETERMINISTIC REACHABILITY TEST TEMPLATE  (T7 — the non-flaky companion to the coverage canary)
// ---
// WHY THIS EXISTS (engagement 12 run): the probabilistic coverage canary — assert a deep state was NEVER
// reached, watch it FAIL to prove the fuzzer got there — is FLAKY on long dependency chains. If the
// fuzzer needs a 6-call sequence (deposit -> migrate -> settle -> service -> request -> redeem) to
// reach the exploit state, a bounded random campaign may never hit it, and the canary then stays
// green (never trips) exactly like a genuinely-unreachable state. A green invariant that never ran
// the code is a lie — and a fuzz "REFUTED" is only trustworthy once you have PROVEN the exploit path
// is reachable. This test does that deterministically: it hand-drives the exact worst-case sequence
// and asserts the deep state was reached. Pair one of these with every fuzz campaign whose target
// state sits behind a multi-call chain.
//
// CONTRACT:
//   Precondition : the protocol + actors are deployed the same way the invariant harness deploys them.
//   Postcondition: the named deep state (the one the invariant/PoC depends on) is provably reached,
//                  asserted on concrete on-chain reads — NOT on a ghost counter the harness also writes.
//   Invariant    : this test is deterministic (no fuzz inputs) so it either reaches the state on every
//                  run or never does; a flake here is a real bug in the sequence, not sampling noise.
//
// Copy to test/reach/<Protocol>Reach.t.sol and fill the TODOs.
// ===========================================================================================

import {Test} from "forge-std/Test.sol";
// TODO import the full deploy helper, the protocol interface, token mock, position/NFT type.

