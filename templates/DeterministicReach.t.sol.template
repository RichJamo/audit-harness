    ///      Example seam (engagement 12 shaped): composite state across migration + live settlement + servicing
    ///      + 7540 request interleaved — the seam no point-audit modeled together.
    function test_reach_deepState() public {
        // ---- the multi-call chain to the deep state (fill with the real entry points) ----
        // vm.prank(alice); protocol.deposit(productId, amount);
        // vm.prank(admin); protocol.migrate(productId);
        // vm.prank(admin); protocol.settle(productId, rate);      // live exchange settlement
        // vm.prank(admin); protocol.service(productId);           // servicer discretion path
        // vm.prank(bob);   protocol.requestRedeem(productId, shares); // 7540 controller path
        // vm.prank(bob);   protocol.redeem(productId);

        // ---- PROVE reach on concrete state, not on a harness-written ghost ----
        // assertGt(protocol.pendingRedeem(productId, bob), 0, "UNREACHED: redeem path never entered");
        // assertTrue(protocol.isSettled(productId), "UNREACHED: settlement state not entered");
        // If any assert fails, the exploit path is NOT reachable as written — fix the sequence before
