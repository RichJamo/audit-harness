    constructor(/* IProtocol _p, MockToken _t, */ address _admin, uint256[] memory _entities) {
        admin = _admin;
        for (uint256 i = 0; i < _entities.length; i++) entities.push(_entities[i]);
        for (uint256 i = 0; i < 5; i++) {
            address a = makeAddr(string(abi.encodePacked("u", vm.toString(i))));
            actors.push(a);
