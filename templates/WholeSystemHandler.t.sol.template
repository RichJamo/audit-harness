    // ---- Coverage counters (prove deep states reached; see the canary in the test) ----
    uint256 public covFund; uint256 public covDistribute; uint256 public covRedeem; uint256 public covClaim;

    constructor(/* IProtocol _p, MockToken _t, */ address _admin, uint256[] memory _entities) {
        admin = _admin;
        for (uint256 i = 0; i < _entities.length; i++) entities.push(_entities[i]);
        for (uint256 i = 0; i < 5; i++) {
            address a = makeAddr(string(abi.encodePacked("u", vm.toString(i))));
            actors.push(a);
            // TODO: vm.prank(a); token.approve(address(protocol), type(uint256).max);  // mind USDT 0->max-only
        }
        // TODO: vm.prank(admin); token.approve(address(protocol), type(uint256).max);
    }

    function _entity(uint256 s) internal view returns (uint256) { return entities[s % entities.length]; }
    function _proxyBal() internal view returns (uint256) { /* TODO token.balanceOf(address(protocol)); */ return 0; }

    // Each action: pick an entity, guard, prank the right actor, try/catch, measure balance delta.
    function doFund(uint256 eSeed, uint256 aSeed, uint256 amtSeed) external {
        // bound amount; mint to actor; vm.prank(actor); try invest/deposit { fundedIn[e]+=amt; covFund++; tokensOf[e].push(id);} catch {}
