    function doDistribute(uint256 eSeed) external {
        uint256 e=_entity(eSeed); uint256 b=_proxyBal();
        // vm.prank(admin); try protocol.distribute(e) {} catch {}
        uint256 a=_proxyBal(); if (b>a){paidOut[e]+=b-a; covDistribute++;}
    }
    function doRedeem(uint256 eSeed) external {
        uint256 e=_entity(eSeed); uint256 b=_proxyBal();
        // vm.prank(admin); try protocol.mature/redeem(e) {} catch {}
        uint256 a=_proxyBal(); if (b>a){paidOut[e]+=b-a; covRedeem++;}
    }
    function doClaim(uint256 eSeed, uint256 tSeed) external {
        uint256 e=_entity(eSeed); uint256 b=_proxyBal();
        // pick token, owner=ownerOf (try/catch burned); vm.prank(owner); try protocol.claim(e,tok) {} catch {}
        uint256 a=_proxyBal(); if (b>a){paidOut[e]+=b-a; covClaim++;}
    }
    function doWithdraw(uint256 eSeed) external {
        uint256 b=_proxyBal();
        // vm.prank(admin); try protocol.withdraw(...) {} catch {}
        uint256 a=_proxyBal(); withdrawnToSink += b-a;
    }
