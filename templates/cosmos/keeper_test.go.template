// ------------------------------------------------------------------------------------------
// PoC 1 — theft / conservation break via a message handler
// ------------------------------------------------------------------------------------------
func TestPoC_AttackerDrainsModuleAccount(t *testing.T) {
	ctx, _ /*k*/, _ /*deps*/ := setupKeeper(t)

	attacker := sdk.AccAddress([]byte("attacker____________"))

	// ---- pre-state snapshot (the control baseline) ----
	// moduleBefore := deps.Bank.GetBalance(ctx, moduleAcc, denom).Amount
	// attackerBefore := deps.Bank.GetBalance(ctx, attacker, denom).Amount
	var moduleBefore, attackerBefore math.Int

	// ---- build + run the ATTACKER message (the single call under test) ----
	// This is where the account-model-free authority bug lives: pass the attacker as an authority
	// the handler never checks, a duplicate/wrong reference, an amount that underflows, a
	// wrong-denom coin credited as the real asset, etc. Enumerate the substitution explicitly.
	// msg := &types.MsgWithdraw{ Authority: attacker.String(), Amount: sdk.NewCoin(denom, someAmt) }
	// _, err := msgServer.Withdraw(ctx, msg)
	var err error = nil // TODO real call

	// ---- COVERAGE CANARY: prove the attacker path actually executed and reached the deep state.
	// Where success IS the exploit, require err == nil; where the exploit is a specific failure,
	// require THAT exact error. A handler that reverted before the vulnerable code proves nothing.
	require.NoError(t, err,
		"attacker msg failed before the exploit path ran — fix the PoC; do NOT record REFUTED off a "+
			"handler that never executed the vulnerable code")

	// ---- QUANTIFIED assertion: the invariant is broken (theft demonstrated) ----
	// moduleAfter := deps.Bank.GetBalance(ctx, moduleAcc, denom).Amount
	// attackerAfter := deps.Bank.GetBalance(ctx, attacker, denom).Amount
	// require.True(t, attackerAfter.GT(attackerBefore), "no funds moved to attacker")
	// require.True(t, moduleAfter.LT(moduleBefore), "module account not drained")
	// require.True(t, attackerAfter.Sub(attackerBefore).Equal(moduleBefore.Sub(moduleAfter)),
	//     "conservation: what left the module must equal what the attacker gained")
	_ = moduleBefore
	_ = attackerBefore
	// >>> The assertion that FAILS on a patched chain and PASSES here is the finding. <<<
	//
	// VARIANT — assert on what the module PASSED to a mocked collaborator (validated on engagement 13 H-01,
	// where the bug is a wrong ARGUMENT to FundCommunityPool, not a bank delta). If the fixture wires
	// a mock, read its recorded tally as the post-state, and AMPLIFY with >=2 qualifying coins:
	//   // burn {foo:50, baz:50}; the per-coin loop wrongly passes the WHOLE set each iteration →
	//   // the mock records foo=100/baz=100 (200 moved vs 100 burned = a clean 2x over-move).
	//   require.Equal(t, math.NewInt(100), deps.MockCommunityPool.CommunityPool.AmountOf("foo"),
	//       "over-move: burned 50 foo but the per-coin loop moved the full set twice (100)")
	//   // >>> flip the one-line fix (`amount` -> sdk.NewCoins(coin)), re-run, watch this FAIL,
	//   //     then revert — proving the assertion discriminates buggy from patched (PP Tip 37). <<<
}

