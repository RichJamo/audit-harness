// ------------------------------------------------------------------------------------------
// A) NONDETERMINISM → HALT  (checklist §1, PC §1)
// Run the SAME operations against TWO freshly-built apps from the SAME genesis/seed and compare the
// resulting AppHash. If the suspect path (map-range-with-order-effect, float, time.Now, goroutine,
// map-marshal) is nondeterministic, the two AppHashes differ — which in production is honest nodes
// computing different state and consensus halting.
// ------------------------------------------------------------------------------------------
func TestPoC_Nondeterminism(t *testing.T) {
	run := func() []byte {
		// TODO: build a fresh app from a FIXED genesis (identical across both runs):
		//   app := testapp.Setup(t, false)
		//   ctx := app.NewContext(false)  // (v0.50+: NewContextLegacy / NewContext per version)
		//
		// Drive the EXACT suspect path deterministically — e.g. deliver the tx / call the keeper
		// method that ranges the map, then run the blocker that materializes the order-sensitive
		// effect. Do the identical sequence in both runs.
		//   app.FinalizeBlock(&abci.RequestFinalizeBlock{Height: 1, ...})
		//   res, _ := app.Commit()
		//   return res.  // the AppHash Commit returns, OR read the specific state bytes the
		//                // suspect path wrote (store.Get(key)) for a tighter signal.
		return nil // TODO
	}

	// CANARY: both runs must have actually EXECUTED the suspect path. If your `run` short-circuits
	// (skips the tx, the blocker never fires), you are comparing empty hashes and proving nothing.
	// Assert the path ran (e.g. the effect key exists) before trusting the comparison.
	h1 := run()
	h2 := run()
	require.NotEmpty(t, h1, "run 1 produced no state — the suspect path never executed (canary failed)")

	// THE FINDING: on a deterministic chain h1 == h2 across identical inputs. Divergence == halt.
	// (Run `run()` more than twice if the nondeterminism is probabilistic — e.g. a small map where
	//  iteration order collides often; loop N times and assert all-equal, else it's flaky-negative.)
	require.Equal(t, h1, h2,
		"NONDETERMINISM: identical inputs produced different state on two runs — honest validators "+
			"would compute different AppHashes here and consensus would HALT/fork. This assertion "+
			"FAILING is the finding.")
}

